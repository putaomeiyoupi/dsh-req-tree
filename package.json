{
  "name": "dsh-req-tree",
  "version": "0.1.0",
  "description": "把 req-tree 需求派生树搬进 DeepSeek Harness：右侧栏一个只读 Tab，直接看到当前工作区的需求树状态、收口进度与告警。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.bundle.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "req-tree",
    "requirements",
    "todo",
    "requirement-tree",
    "sidebar"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test test/*.test.mjs",
    "check-install": "node scripts/check-install.mjs",
    "verify": "npm run build && npm test && npm run check-install",
    "prepublishOnly": "npm run verify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/putaomeiyoupi/dsh-req-tree.git"
  },
  "homepage": "https://github.com/putaomeiyoupi/dsh-req-tree#readme",
  "bugs": {
    "url": "https://github.com/putaomeiyoupi/dsh-req-tree/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org/"
  },
  "author": {
    "name": "putaomeiyoupi"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "jsdom": "^30.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
